# Copy to deploy/production.env and edit. Never commit the real file.

# Public hostname, no scheme or path.
TASTEPRO_DOMAIN=mcp.example.com

# Published image. Use the digest or an immutable version tag.
TASTEPRO_IMAGE=ghcr.io/your-org/tastepro:1.0.0

# OAuth resource-server settings. TastePro validates tokens from this IdP; it
# does not issue them. The audience defaults to https://$TASTEPRO_DOMAIN/mcp.
TASTEPRO_OAUTH_ISSUER=https://idp.example.com/realms/tastepro
#TASTEPRO_OAUTH_AUDIENCE=https://mcp.example.com/mcp
#TASTEPRO_OAUTH_JWKS_URI=

# Exact browser origins, comma-separated. Server-to-server MCP clients do not
# need CORS. Do not use * in production.
#TASTEPRO_CORS_ORIGIN=

# taste_audit. URL fetching is off by default; browser mode requires the
# separate audit image (Dockerfile.audit) and TASTEPRO_AUDIT_BROWSER=playwright.
TASTEPRO_AUDIT_ENABLED=true
TASTEPRO_AUDIT_ALLOW_URL_FETCH=false
TASTEPRO_AUDIT_MAX_CONCURRENCY=2
TASTEPRO_AUDIT_MAX_QUEUE=8

# debug | info | warn | error | silent
TASTEPRO_LOG_LEVEL=info
