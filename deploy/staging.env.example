# Copy to deploy/staging.env and edit. Never commit the real file.
#
# The domain must already resolve to the staging host. Caddy needs ports 80 and
# 443 (TCP and UDP) reachable for ACME.

# Public hostname, no scheme or path. Example: mcp-staging.example.com
TASTEPRO_DOMAIN=mcp-staging.example.com

# Optional bearer token for /mcp. Generate one with:
#   openssl rand -hex 32
#
# Leave empty ONLY for an intentionally anonymous read-only endpoint. Hosted
# audit endpoints (M2+) must be auth-gated.
TASTEPRO_API_KEY=

# Exact browser origins, comma-separated. Server-to-server MCP clients do not
# need CORS. Do not use * on a public endpoint unless you have a reason.
TASTEPRO_CORS_ORIGIN=https://chatgpt.com,https://chat.openai.com

# debug | info | warn | error | silent
TASTEPRO_LOG_LEVEL=info
