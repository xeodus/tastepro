# Copy to deploy/staging.env and edit. Never commit the real file.
#
# The domain must already resolve to the staging host. Caddy needs ports 80 and
# 443 (TCP and UDP) reachable for ACME.

# Public hostname, no scheme or path. Example: mcp-staging.example.com
TASTEPRO_DOMAIN=mcp-staging.example.com

# Optional bearer token for /mcp. Generate one with:
#   openssl rand -hex 32
#
# Leave empty ONLY for an intentionally anonymous read-only endpoint. Anonymous
# non-loopback binds also require TASTEPRO_ALLOW_ANONYMOUS=true, and such
# endpoints never expose the taste_audit tool.
#
# EITHER this key OR the OAuth settings below, never both.
TASTEPRO_API_KEY=
TASTEPRO_ALLOW_ANONYMOUS=false

# OAuth (resource server) — the recommended hosted auth mode. TastePro
# validates tokens from your IdP; it does not issue them. Uncomment and fill
# from your IdP. The audience defaults to https://$TASTEPRO_DOMAIN/mcp and the
# JWKS is discovered from the issuer unless you set TASTEPRO_OAUTH_JWKS_URI.
# The taste_audit tool requires the tastepro:audit scope.
#TASTEPRO_OAUTH_ISSUER=https://idp.example.com
#TASTEPRO_OAUTH_JWKS_URI=

# taste_audit. Disabled URL input and browser rendering are the safe defaults.
# URL input is SSRF-guarded; browser rendering requires playwright in the image.
TASTEPRO_AUDIT_ENABLED=true
TASTEPRO_AUDIT_ALLOW_URL_FETCH=false
#TASTEPRO_AUDIT_BROWSER=playwright

# Exact browser origins, comma-separated. Server-to-server MCP clients do not
# need CORS. Do not use * on a public endpoint unless you have a reason.
TASTEPRO_CORS_ORIGIN=https://chatgpt.com,https://chat.openai.com

# debug | info | warn | error | silent
TASTEPRO_LOG_LEVEL=info
