# TastePro configuration
# Content directory (defaults to ./content next to the package)
# TASTEPRO_CONTENT_DIR=./content

# HTTP transport
TASTEPRO_HOST=127.0.0.1
TASTEPRO_PORT=3000

# Optional bearer token. When set, all /mcp requests require:
#   Authorization: Bearer <token>
# TASTEPRO_API_KEY=

# Comma-separated allowed origins for browser CORS. Browser origins are denied
# by default. Server-to-server MCP clients do not need CORS. Use * only for
# local browser testing.
# TASTEPRO_CORS_ORIGIN=https://app.example.com

# Comma-separated Host header allowlist for the HTTP transport. Set this in
# hosted deployments. Include loopback names if the container healthcheck uses
# them, e.g. mcp.example.com,localhost,127.0.0.1
# TASTEPRO_ALLOWED_HOSTS=

# Logging: debug | info | warn | error | silent
TASTEPRO_LOG_LEVEL=info

# Public base URL used in hosted artifact links (M2+)
# TASTEPRO_PUBLIC_URL=https://mcp.example.com
