# syntax=docker/dockerfile:1.7
#
# Optional audit image. The default Dockerfile stays Playwright-free; this
# image adds Chromium and enables browser mode for taste_audit. It is
# substantially larger and must run with CPU/memory limits and a larger
# /dev/shm. Prefer submitting HTML over enabling URL fetching.
#
# Bun installs, builds, and prepares Playwright; the server runs on Node 22
# because Playwright's library support under Bun is not officially guaranteed.
#
#   docker build -f Dockerfile.audit -t tastepro:audit .
#   docker run --rm -p 127.0.0.1:3000:3000 \
#     -e TASTEPRO_API_KEY="$(openssl rand -hex 32)" \
#     -e TASTEPRO_ALLOWED_HOSTS=localhost,127.0.0.1 \
#     --shm-size=1g --memory=2g --cpus=2 \
#     tastepro:audit

ARG BUN_VERSION=1.4.4
ARG NODE_VERSION=22
ARG PLAYWRIGHT_VERSION=1.65.0

FROM oven/bun:${BUN_VERSION} AS deps
WORKDIR /app
COPY package.json bun.lock ./
RUN bun ci

FROM oven/bun:${BUN_VERSION} AS build
WORKDIR /app
COPY --from=deps /app/node_modules ./node_modules
COPY package.json bun.lock tsconfig.json tsconfig.build.json ./
COPY src ./src
RUN bun run build

FROM oven/bun:${BUN_VERSION} AS prod-deps
WORKDIR /app
COPY package.json bun.lock ./
RUN bun install --frozen-lockfile --production

FROM oven/bun:${BUN_VERSION} AS playwright
WORKDIR /pw
ENV PLAYWRIGHT_BROWSERS_PATH=/ms-playwright \
    PLAYWRIGHT_SKIP_BROWSER_DOWNLOAD=1
COPY package.json bun.lock ./
RUN bun add --no-save playwright@${PLAYWRIGHT_VERSION} \
    && bunx playwright install chromium

FROM node:${NODE_VERSION}-bookworm-slim AS runtime
WORKDIR /app

ENV NODE_ENV=production \
    TASTEPRO_HOST=0.0.0.0 \
    TASTEPRO_PORT=3000 \
    TASTEPRO_LOG_LEVEL=info \
    TASTEPRO_AUDIT_BROWSER=playwright \
    PLAYWRIGHT_BROWSERS_PATH=/ms-playwright

COPY --from=prod-deps /app/node_modules ./node_modules
COPY --from=playwright /pw/node_modules/playwright ./node_modules/playwright
COPY --from=playwright /pw/node_modules/playwright-core ./node_modules/playwright-core
COPY --from=playwright /ms-playwright /ms-playwright
COPY --from=build /app/dist ./dist
COPY package.json ./
COPY content ./content
COPY LICENSE NOTICE ATTRIBUTION.md README.md ./
# Install Chromium's OS libraries in the runtime image. The Bun builder only
# downloads the browser; these packages must exist where Node runs it.
RUN node node_modules/playwright/cli.js install-deps chromium \
    && rm -rf /var/lib/apt/lists/* \
    && chown -R node:node /app /ms-playwright

USER node

EXPOSE 3000
STOPSIGNAL SIGTERM

HEALTHCHECK --interval=30s --timeout=5s --start-period=15s --retries=3 \
  CMD node -e "fetch('http://127.0.0.1:'+(process.env.TASTEPRO_PORT||3000)+'/healthz').then((r)=>{if(!r.ok)process.exit(1)}).catch(()=>process.exit(1))"

CMD ["node", "dist/cli.js", "--http"]
